\ProvidesPackage{Commands}

\newcommand{\ContactLine}[2]{%
  {\ResumeRegular\fontsize{9.6bp}{15bp}\selectfont
   \makebox[16pt][l]{\color{black}#1}#2\par}%
}
\newcommand{\EmailAddresse}[1]{\ContactLine{\faEnvelopeO}{#1}}
\newcommand{\Addresse}[1]{\ContactLine{\faHome}{#1}}
\newcommand{\PhoneNumbers}[2]{\ContactLine{\faPhone}{#1#2}}
\newcommand{\Name}[1]{{\ResumeLight #1\par}}
\newcommand{\RoleDescription}[1]{%
  {\ResumeLight\fontsize{12bp}{16bp}\selectfont #1\par}%
}
\newcommand{\WorkLocation}[1]{%
  {\ResumeLight\fontsize{9.4bp}{12.5bp}\selectfont #1}%
}
\newcommand{\WorkPeriod}[2]{%
  {\ResumeLight\fontsize{8.6bp}{12.5bp}\selectfont #1 \textendash{} #2}%
}

% Job titles and descriptions share a left column; dates and locations sit
% in the narrow right column, as in the reference. The zero-height metadata
% box lets the first bullets start directly beneath the title.
\newcommand{\ResumeMetadata}[2]{%
  \parbox[t]{0.15\textwidth}{%
    \raggedleft\leavevmode\color{ResumeMuted}#1\par\vspace{5pt}#2\par}%
}
\newcommand{\ResumeEntryHeading}[5][6\baselineskip]{%
  \Needspace{#1}%
  \item
  \noindent\makebox[0pt][l]{%
    \hspace{0.85\textwidth}%
    \smash{\ResumeMetadata{#4}{#5}}}%
  \begin{minipage}[t]{0.84\textwidth}
    \raggedright
    {#2} {#3}\par
  \end{minipage}\par\nobreak
}
\newcommand{\resumeSubheading}[4]{%
  \ResumeEntryHeading
    {\ResumeSlab\bfseries\fontsize{11.5bp}{15bp}\selectfont #1}
    {\ResumeRegular\fontsize{10.3bp}{14bp}\selectfont #2}
    {#3}{#4}%
}
\newcommand{\resumeEmploymentSubheading}[5][6\baselineskip]{%
  \ResumeEntryHeading[#1]
    {\ResumeLight\mdseries\fontsize{10.3bp}{14bp}\selectfont #2~\textbar}
    {\ResumeRegular\bfseries\fontsize{11.5bp}{15bp}\selectfont #3}
    {#4}{#5}%
}

\newcommand{\resumeItem}[2]{%
  \item {\ResumeRegular #1:} #2\par
}
% The first argument is retained for the original spacing-only placeholder.
\newcommand{\resumeSubItem}[2]{\item #2\par}

% Separate rounded tags, with breaks allowed only between complete tags.
\newcommand{\ResumeTag}[1]{%
  \tikz[baseline=(tag.base)]{%
    \node[fill=ResumeTint,rounded corners=1.4pt,
      inner xsep=3pt,inner ysep=1.4pt,outer sep=0pt,
      text height=6.7pt,text depth=1.8pt] (tag) {#1};}%
}
\ExplSyntaxOn
\seq_new:N \l__resume_pending_tags_seq
\seq_new:N \l__resume_remaining_tags_seq
\dim_new:N \l__resume_tag_row_width_dim
\box_new:N \l__resume_tag_box

% Fill each row with every remaining tag that fits before starting another.
% This lets a shorter later tag use space left by a longer tag that must wrap.
\cs_new_protected:Npn \__resume_tag_row:
  {
    \seq_clear:N \l__resume_remaining_tags_seq
    \dim_zero:N \l__resume_tag_row_width_dim
    \noindent
    \seq_map_inline:Nn \l__resume_pending_tags_seq
      {
        \hbox_set:Nn \l__resume_tag_box {\ResumeTag{##1}}
        \dim_compare:nNnTF {\l__resume_tag_row_width_dim} = {0pt}
          {
            \box_use:N \l__resume_tag_box
            \dim_set:Nn \l__resume_tag_row_width_dim
              {\box_wd:N \l__resume_tag_box}
          }
          {
            \dim_compare:nNnTF
              {\l__resume_tag_row_width_dim + 3pt + \box_wd:N \l__resume_tag_box}
              > {\linewidth}
              {\seq_put_right:Nn \l__resume_remaining_tags_seq {##1}}
              {
                \hspace{3pt}\box_use:N \l__resume_tag_box
                \dim_add:Nn \l__resume_tag_row_width_dim
                  {3pt + \box_wd:N \l__resume_tag_box}
              }
          }
      }
    \par
    \seq_if_empty:NF \l__resume_remaining_tags_seq
      {
        \seq_set_eq:NN \l__resume_pending_tags_seq \l__resume_remaining_tags_seq
        \__resume_tag_row:
      }
  }
\NewDocumentCommand{\ResumeTags}{m}{
  \seq_set_from_clist:Nn \l__resume_pending_tags_seq {#1}
  \__resume_tag_row:
}
\ExplSyntaxOff

% Entries are comma-separated; protect internal commas with braces, e.g.
% {Python (Django, FastAPI, Flask)}, PostgreSQL, {LLMs (Gemini, GPT)}.
\newcommand{\environment}[1]{%
  \item[]\hspace*{-12pt}%
  \begin{minipage}[t]{\dimexpr\linewidth+12pt\relax}
    \fontsize{8.75bp}{14bp}\selectfont\ResumeRegular
    \begin{tabularx}{\linewidth}{@{}l@{\hspace{5pt}}X@{}}
      {\ResumeMedium Environment:} &
      \raggedright\ResumeTags{#1}
    \end{tabularx}
  \end{minipage}\par
}

\newcommand{\SkillSet}[2]{\item {\ResumeMedium #1:} #2\par}
\newcommand{\Certification}[3]{\item {\ResumeMedium #1:} #2(#3).\par}
\newcommand{\LanguageSet}[2]{\item {\ResumeMedium #1:} #2\par}

